#include <winver.h>
1 ICON "../../app/PlantCollector.ico"
1 24 "launcher.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_A,VER_B,VER_C,0
PRODUCTVERSION VER_A,VER_B,VER_C,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Tishko"
      VALUE "FileDescription", DESC
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", NAME
      VALUE "OriginalFilename", NAME ".exe"
      VALUE "ProductName", "CCI Plant Monitoring"
      VALUE "ProductVersion", VER_STR
      VALUE "LegalCopyright", "Tishko"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
